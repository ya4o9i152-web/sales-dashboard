# Supabase（Project Settings → API）。サービスロールのキーはアプリでは使わない
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxx
# CLAUDE_MODEL=claude-opus-5-5

# Vercel Cron の呼び出しを確かめる合言葉（Vercel が自動で Authorization ヘッダーに付ける）
CRON_SECRET=

# scripts/add-user.ts だけが使う（ユーザーの登録）。Vercel には置かない
SUPABASE_SECRET_KEY=
